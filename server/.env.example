# Copy this file to .env and fill it in. Never commit .env.
PORT=5181
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://printhub:CHANGE_ME@localhost:5432/printhub
# Long random text. Changing it logs every staff member out.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_TEXT
# Where customer files are kept (created if missing).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=80
# Country code used for phone numbers that start with 0.
DEFAULT_COUNTRY_CODE=254
# Only for `npm test`: a separate, empty database (tests wipe it).
TEST_DATABASE_URL=postgres://printhub:CHANGE_ME@localhost:5432/printhub_test
