# PrintHub settings. EVERY LINE IS OPTIONAL: with no .env file at all, PrintHub runs on
# this computer with its built-in database (kept in server/data). To change something,
# copy this file to .env and remove the # in front of that line. Never commit .env.

# The address is http://localhost:PORT. The app's dev server expects 5181.
#PORT=5181

# Where orders are kept.
#   (no line)                 the built-in database in server/data. Nothing to install.
#                             Good for testing and for one computer. Back up server/data.
#   postgres://USER:PASSWORD@HOST:5432/DATABASE
#                             a PostgreSQL server. Use this when PrintHub is hosted.
#DATABASE_URL=postgres://printhub:YOUR_PASSWORD@localhost:5432/printhub

# The secret that signs logins. Without this line a random one is made and kept in
# server/data/secret.key. When hosting, put a long random text here.
#JWT_SECRET=

# Where customer files are kept (created if missing).
#UPLOAD_DIR=./uploads
#MAX_UPLOAD_MB=80
# Country code used for phone numbers that start with 0.
#DEFAULT_COUNTRY_CODE=254

# Only for `npm test`. Without this line the tests use a throw-away built-in database.
# With it, they use that PostgreSQL database and WIPE it on every run.
#TEST_DATABASE_URL=postgres://printhub:YOUR_PASSWORD@localhost:5432/printhub_test
